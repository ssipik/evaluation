{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "rag_evaluation - generate",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_evaluation",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "generate",
                "--n", "50",
                "--workers", "4",
                // "--seed", "42",
            ],
        },
        {
            "name": "rag_evaluation - aggregate",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_evaluation",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "aggregate",
                "--session-id", "generate-20260831-140203-b505ce",
            ],
        },
        {
            "name": "rag_evaluation - pool",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_evaluation",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "pool",
                "--session-id", "generate-20260831-140203-b505ce",
            ],
        },
        {
            "name": "rag_evaluation - curve",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_evaluation",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "RAG_RETRIEVE_TOP_K": "7"
            },
            "args": [
                "curve",
                // "--param", "top_k", "--values", "1:21",
                // "--run-name", "tunning_top_k",
                "--param", "rrf_k", "--values", "1:21",
                "--set-params", "top_k=7",
                "--run-name", "tunning_rrf_k",
            ],
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--base-url", "https://get-capital.atlassian.net",
                "--root-page-id", "1037991938",
                "--label", "RAG",
                "--apply",
                // "--skip-root",
                // "--remove",
            ]
        }
    ]
}