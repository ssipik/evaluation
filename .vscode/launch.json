    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "rag_evaluation - generate",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_evaluation",
            "args": [
                "generate",
                "--n", "50",
                "--workers", "4",
                // "--seed", "42",
            ],
        },
        {
            "name": "rag_evaluation - aggregate",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_evaluation",
            "args": [
                "aggregate",
                // "--session-id", "generate-20260821-192458-e4bdc8",
                "--session-id", "generate-20260825-184221-e18b2b",
            ],
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--base-url", "https://get-capital.atlassian.net",
                "--root-page-id", "1037991938",
                "--label", "RAG",
                "--apply",
                // "--skip-root",
                // "--remove",
            ]
        }
    ]
}